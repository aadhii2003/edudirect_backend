# Backend PostgreSQL Database Config
DB_NAME=edudirect_db
DB_USER=postgres
DB_PASSWORD=pass
DB_HOST=db
DB_PORT=5432

# Django Config
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# Frontend API URL (Used by Next.js in Docker to reach backend)
NEXT_PUBLIC_API_URL=http://localhost:8001/api
